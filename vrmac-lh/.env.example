# ── VRMAC-LH prototype ── copy to .env and adjust. Secrets come from here only; nothing is hard-coded.
# Prototype built for the SMART ERA application, September–October 2026. Sample data.

# Compose profiles: "local-llm" starts Ollama (open-source LLM + multilingual embeddings, CPU only).
# Remove it if you point LLM_PROVIDER/EMBEDDINGS_PROVIDER at a hosted API instead.
COMPOSE_PROFILES=local-llm

# --- app -------------------------------------------------------------------
APP_ENV=dev                      # dev | prod  (prod refuses the placeholder secret below)
SECRET_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
LOCAL_LANGUAGE=cnr

# --- database (PostgreSQL 16 + pgvector) -----------------------------------
POSTGRES_USER=vrmac
POSTGRES_PASSWORD=vrmac
POSTGRES_DB=vrmac
DATABASE_URL=postgresql+psycopg://vrmac:vrmac@db:5432/vrmac
# read-only visitor role; row-level security limits it to approved rows
PUBLIC_DB_USER=vrmac_public
PUBLIC_DB_PASSWORD=vrmac_public

# --- queue -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=rq                    # rq | sync

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=ollama              # ollama | openai | none
LLM_MODEL=qwen2.5:1.5b           # small enough for 2 vCPU / 4 GB
OLLAMA_URL=http://ollama:11434
# for LLM_PROVIDER=openai (any OpenAI-compatible endpoint: OpenAI, Groq, Mistral, vLLM…)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=

# --- embeddings / RAG ----------------------------------------------------------
EMBEDDINGS_PROVIDER=ollama       # ollama | sentence-transformers | hash (offline test mode)
EMBEDDINGS_MODEL=paraphrase-multilingual
EMBEDDING_DIM=768
RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.60        # leave unset for the provider default
RAG_MIN_COVERAGE=0.34

# --- speech-to-text ---------------------------------------------------------
STT_PROVIDER=faster-whisper      # faster-whisper | api | fixture (tests only)
STT_MODEL=small                  # tiny | base | small (CPU int8)
STT_LANGUAGE=hr                  # Whisper has no Montenegrin code; 'hr' gives Latin-script output
STT_COMPUTE_TYPE=int8
STT_API_BASE=
STT_API_KEY=
STT_API_MODEL=whisper-1
KEEP_AUDIO=false                 # audio deleted after transcription

# --- maps -------------------------------------------------------------------
MAPS_PROVIDER=osm                # osm (MapLibre + OpenStreetMap, default) | google (optional base layer)
GOOGLE_MAPS_API_KEY=

# --- KPIs & security ----------------------------------------------------------
KPI_K_MIN=5
ONBOARDING_TARGET_MINUTES=30
RATE_LIMIT_PUBLIC=120/minute
RATE_LIMIT_ASK=20/minute
SEED_PASSWORD=prototype123       # password of the sample accounts (host1@example.org …)

# --- reverse proxy (profile "proxy") ---------------------------------------------
DOMAIN=localhost                 # set to your VPS hostname for automatic TLS via Caddy
