# ── VRMAC-LH prototype ── copy to .env and adjust (make env does it and generates the secrets).
# Prototype built for the SMART ERA application, September–October 2026. Sample data.
# Secrets come from this file only; nothing is hard-coded.

# Compose profiles. "local-llm" starts Ollama so `docker compose up` works with no API key and no
# network model service — the setting shipped here. For the pilot, switch LLM_PROVIDER to eu_api
# (below) and set COMPOSE_PROFILES= (empty) so no local model server is started.
COMPOSE_PROFILES=local-llm

# --- app -------------------------------------------------------------------
APP_ENV=dev                      # dev | prod  (prod refuses placeholders and unconfirmed contracts)
SECRET_KEY=replace-with-openssl-rand-hex-32
# HMAC key that pseudonymises every identifier written to the event stream. Required in prod;
# rotating it makes all historical pseudonyms unlinkable to new data.
EVENT_PSEUDONYM_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
LOCAL_LANGUAGE=cnr

# --- database (PostgreSQL 16 + pgvector) -----------------------------------
POSTGRES_USER=vrmac
POSTGRES_PASSWORD=vrmac
POSTGRES_DB=vrmac
DATABASE_URL=postgresql+psycopg://vrmac:vrmac@db:5432/vrmac
# read-only visitor role; row-level security limits it to approved rows
PUBLIC_DB_USER=vrmac_public
PUBLIC_DB_PASSWORD=vrmac_public

# --- queue -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=rq                    # rq | sync

# --- LLM ---------------------------------------------------------------------
# PILOT (primary): an open-weight model consumed pay-per-use from an EU inference provider under a
# no-data-retention contract. Any OpenAI-compatible endpoint works (Scaleway, OVHcloud, Mistral,
# Nebius…). APP_ENV=prod refuses to start unless the no-data-retention contract is confirmed.
#   LLM_PROVIDER=eu_api
#   LLM_PROVIDER_NAME=scaleway
#   LLM_MODEL=mistral-nemo-instruct-2407
#   LLM_API_BASE=https://api.scaleway.ai/v1
#   LLM_API_KEY=
#   LLM_NO_DATA_RETENTION_CONFIRMED=true
#   LLM_REGION_NOTE=EU (Paris)
#   COMPOSE_PROFILES=
#
# DEMO LAPTOP / OFFLINE VENUE (shipped default): the same open-weight family, self-hosted.
LLM_PROVIDER=ollama              # eu_api | ollama | vllm | none
LLM_PROVIDER_NAME=ollama
LLM_MODEL=qwen2.5:1.5b           # small enough for 2 vCPU / 4 GB
OLLAMA_URL=http://ollama:11434
LLM_API_BASE=
LLM_API_KEY=
LLM_NO_DATA_RETENTION_CONFIRMED=false
LLM_REGION_NOTE=self-hosted

# Monthly spend cap, enforced in code. When it is reached the assistant serves cached answers and
# otherwise says it is paused — it never produces unsourced text.
LLM_MONTHLY_CAP_EUR=50
LLM_PRICE_INPUT_EUR_PER_MTOK=0.20    # set to your provider's price list
LLM_PRICE_OUTPUT_EUR_PER_MTOK=0.60
STT_PRICE_EUR_PER_MINUTE=0.006

# --- embeddings / retrieval ----------------------------------------------------
EMBEDDINGS_PROVIDER=ollama       # eu_api | ollama | sentence-transformers | hash (offline tests)
EMBEDDINGS_MODEL=paraphrase-multilingual
EMBEDDINGS_API_BASE=             # defaults to LLM_API_BASE
EMBEDDINGS_API_KEY=
EMBEDDING_DIM=768
RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.60        # leave unset for the provider default
RAG_MIN_COVERAGE=0.34

# --- support check (every answer sentence must be attributable to a cited passage) ---
SUPPORT_CHECK_PROVIDER=llm_judge # llm_judge | lexical (lexical is the deterministic offline check)
SUPPORT_MIN_SCORE=0.75           # conservative on purpose

# --- response cache -----------------------------------------------------------
CACHE_ENABLED=true
CACHE_SEMANTIC_MIN_SIMILARITY=0.92
CACHE_MAX_AGE_DAYS=30

# --- speech-to-text ---------------------------------------------------------
STT_PROVIDER=faster-whisper      # eu_api | faster-whisper | api | fixture (tests only)
STT_MODEL=small                  # tiny | base | small (CPU int8)
STT_LANGUAGE=hr                  # Whisper has no Montenegrin code; 'hr' gives Latin-script output
STT_COMPUTE_TYPE=int8
STT_API_BASE=                    # defaults to LLM_API_BASE for STT_PROVIDER=eu_api
STT_API_KEY=
STT_API_MODEL=whisper-1
KEEP_AUDIO=false                 # audio deleted after transcription

# --- maps -------------------------------------------------------------------
MAPS_PROVIDER=osm                # osm (MapLibre + OpenStreetMap, default) | google (optional layer)
GOOGLE_MAPS_API_KEY=

# --- KPIs & disclosure control ---------------------------------------------------
KPI_K_MIN=5                      # minimum cell size before anything is published
K11_DEDUP_DAYS=180               # single deduplication window for distinct devices (K11)
PILOT_START_DATE=2026-09-01
ONBOARDING_TARGET_MINUTES=30     # median ACTIVE authoring time, excluding review waiting

# --- security ---------------------------------------------------------------
RATE_LIMIT_PUBLIC=120/minute
RATE_LIMIT_ASK=20/minute
SEED_PASSWORD=prototype123       # password of the sample accounts (host1@example.org …)

# --- reverse proxy (profile "proxy") ---------------------------------------------
DOMAIN=localhost                 # set to your VPS hostname for automatic TLS via Caddy
