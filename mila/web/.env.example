# Where the Next.js server forwards /api/* at runtime (app/api/[...path]/route.ts). Read when
# the server starts, so no rebuild is needed to point the same build at another API.
MILA_API_URL=http://localhost:8000

# Optional build-time override for static deployments: when set, the browser calls this origin
# directly instead of the same-origin proxy (the API must then allow the web origin in
# MILA_CORS_ORIGINS). Inlined into the bundle, so rebuild after changing it. Leave empty.
NEXT_PUBLIC_API_BASE=
