# MILA configuration. Copy to .env (git-ignored) and edit. Every MILA_* setting is defined in
# backend/app/config.py; the defaults below are the safe local-development values: SQLite or the
# compose Postgres, deterministic mock providers, no third-party calls. NEVER put real secrets in
# this example file.

# --- runtime ----------------------------------------------------------------------------------
# dev | test | prod. prod disables the API docs, logs at INFO and makes make_demo_data.py refuse to run.
MILA_APP_ENV=dev
# true allows public_unreviewed sources in answers (flagged in the UI). false for a clinical pilot.
MILA_DEMO_MODE=true
# SQLAlchemy URL. docker-compose.yml overrides this with the Postgres service URL.
MILA_DATABASE_URL=sqlite:///./mila.db
# JSON list of browser origins allowed to call the API.
MILA_CORS_ORIGINS=["http://localhost:3000"]
# Sliding-window limit per session id (never per IP).
MILA_RATE_LIMIT_PER_MINUTE=60

# --- LLM (generation and, with MILA_JUDGE_PROVIDER=llm, the support judge) ---------------------
# mock (extractive, deterministic) | openai_compatible (vLLM, llama.cpp, TGI ...; requests carry store=false)
MILA_LLM_PROVIDER=mock
# In compose with --profile local-llm the vLLM service is reachable at http://llm:8001/v1.
MILA_LLM_BASE_URL=http://localhost:8001/v1
# Bearer token for the endpoint, if it needs one. Leave empty for a local server.
MILA_LLM_API_KEY=
# Open-weight model name passed to the endpoint (also pulled by the local-llm profile).
MILA_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
MILA_LLM_TIMEOUT_S=60

# --- retrieval and judge ----------------------------------------------------------------------
# hash (deterministic, no model) | bge_m3 (BAAI/bge-m3, multilingual; needs the "embed" extra)
MILA_EMBEDDER=hash
MILA_EMBEDDING_DIM=256
# lexical (token overlap, upper bound) | llm (uses the configured LLM)
MILA_JUDGE_PROVIDER=lexical
MILA_RETRIEVAL_TOP_K=8

# --- voice ------------------------------------------------------------------------------------
# mock | faster_whisper (needs the "voice" extra and a model download on first use)
MILA_STT_PROVIDER=mock
MILA_STT_MODEL=large-v3
# mock | piper (needs the "voice" extra and voice files in MILA_PIPER_VOICE_DIR)
MILA_TTS_PROVIDER=mock
MILA_PIPER_VOICE_DIR=./models/piper

# --- safety thresholds (change only together with a new measurement report) -------------------
MILA_GATE_MIN_SUPPORT_RATIO=0.6
MILA_GATE_MIN_CONFIDENCE=0.35
# Question coverage of the cited evidence below which an answer is withheld (low_relevance).
MILA_GATE_MIN_RELEVANCE=0.3
# Per-sentence coverage below which a sentence is removed as off_topic.
MILA_GATE_MIN_SENTENCE_RELEVANCE=0.1
# Factor applied to relevance when the question uses a term the knowledge base never uses.
MILA_RELEVANCE_UNKNOWN_TERM_PENALTY=0.85
MILA_VERIFIER_SUPPORT_THRESHOLD=0.5
MILA_REDFLAG_CLASSIFIER_THRESHOLD=0.85

# --- privacy and admin ------------------------------------------------------------------------
# Public metrics rows with a count below this are suppressed.
MILA_K_ANONYMITY=5
# Uploads live here only between upload and transcription; tmpfs in compose.
MILA_AUDIO_TMP_DIR=./.audio_tmp
# X-Admin-Token for /api/admin/*. Empty disables the admin endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MILA_ADMIN_TOKEN=
# Recorded with every consent; change it to force everyone to re-consent.
MILA_CONSENT_VERSION=2026-10-01
# Referral region when the session has none: BA or ME.
MILA_DEFAULT_REGION=BA

# --- knowledge base ---------------------------------------------------------------------------
MILA_KB_DIR=./kb
MILA_MANIFEST_PATH=./kb/manifest.yaml

# --- docker-compose only (not read by the backend) --------------------------------------------
# Password of the compose Postgres service (user mila, database mila). Change it outside a laptop.
MILA_DB_PASSWORD=mila
# Optional dependency groups baked into the API image, e.g. postgres or voice,postgres.
MILA_API_EXTRAS=postgres
MILA_API_MEM_LIMIT=2g
MILA_WEB_MEM_LIMIT=512m
# Origin the browser uses to reach the API (inlined into the web build).
NEXT_PUBLIC_API_BASE=http://localhost:8000
# local-llm profile: context length for vLLM and an optional Hugging Face token for gated models.
MILA_LLM_MAX_MODEL_LEN=8192
HUGGING_FACE_HUB_TOKEN=
